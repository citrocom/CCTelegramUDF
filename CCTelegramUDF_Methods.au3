; Internal: parameter metadata for _CCTelegram_Call (object/array parameters and file parameters per method)
Func __CCTelegram_Meta($sMethod, ByRef $sJsonFields, ByRef $sFileFields)
    $sJsonFields = ""
    $sFileFields = ""
    Switch $sMethod
        Case "addStickerToSet"
            $sJsonFields = "|sticker|"
        Case "answerGuestQuery"
            $sJsonFields = "|result|"
        Case "answerInlineQuery"
            $sJsonFields = "|results|button|"
        Case "answerShippingQuery"
            $sJsonFields = "|shipping_options|"
        Case "answerWebAppQuery"
            $sJsonFields = "|result|"
        Case "copyMessage"
            $sJsonFields = "|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "copyMessages"
            $sJsonFields = "|message_ids|"
        Case "createInvoiceLink"
            $sJsonFields = "|prices|suggested_tip_amounts|"
        Case "createNewStickerSet"
            $sJsonFields = "|stickers|"
        Case "deleteBusinessMessages"
            $sJsonFields = "|message_ids|"
        Case "deleteMessages"
            $sJsonFields = "|message_ids|"
        Case "deleteMyCommands"
            $sJsonFields = "|scope|"
        Case "editEphemeralMessageCaption"
            $sJsonFields = "|caption_entities|reply_markup|"
        Case "editEphemeralMessageMedia"
            $sJsonFields = "|media|reply_markup|"
        Case "editEphemeralMessageReplyMarkup"
            $sJsonFields = "|reply_markup|"
        Case "editEphemeralMessageText"
            $sJsonFields = "|entities|rich_message|link_preview_options|reply_markup|"
        Case "editMessageCaption"
            $sJsonFields = "|caption_entities|reply_markup|"
        Case "editMessageChecklist"
            $sJsonFields = "|checklist|reply_markup|"
        Case "editMessageLiveLocation"
            $sJsonFields = "|reply_markup|"
        Case "editMessageMedia"
            $sJsonFields = "|media|reply_markup|"
        Case "editMessageReplyMarkup"
            $sJsonFields = "|reply_markup|"
        Case "editMessageText"
            $sJsonFields = "|entities|link_preview_options|rich_message|reply_markup|"
        Case "editStory"
            $sJsonFields = "|content|caption_entities|areas|"
        Case "forwardMessage"
            $sJsonFields = "|suggested_post_parameters|"
        Case "forwardMessages"
            $sJsonFields = "|message_ids|"
        Case "getCustomEmojiStickers"
            $sJsonFields = "|custom_emoji_ids|"
        Case "getMyCommands"
            $sJsonFields = "|scope|"
        Case "getUpdates"
            $sJsonFields = "|allowed_updates|"
        Case "giftPremiumSubscription"
            $sJsonFields = "|text_entities|"
        Case "postStory"
            $sJsonFields = "|content|caption_entities|areas|"
        Case "replaceStickerInSet"
            $sJsonFields = "|sticker|"
        Case "restrictChatMember"
            $sJsonFields = "|permissions|"
        Case "savePreparedInlineMessage"
            $sJsonFields = "|result|"
        Case "savePreparedKeyboardButton"
            $sJsonFields = "|button|"
        Case "sendAnimation"
            $sJsonFields = "|ephemeral_message_parameters|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|animation|thumbnail|"
        Case "sendAudio"
            $sJsonFields = "|ephemeral_message_parameters|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|audio|thumbnail|"
        Case "sendChecklist"
            $sJsonFields = "|checklist|reply_parameters|reply_markup|"
        Case "sendContact"
            $sJsonFields = "|ephemeral_message_parameters|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "sendDice"
            $sJsonFields = "|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "sendDocument"
            $sJsonFields = "|ephemeral_message_parameters|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|document|thumbnail|"
        Case "sendGame"
            $sJsonFields = "|reply_parameters|reply_markup|"
        Case "sendGift"
            $sJsonFields = "|text_entities|"
        Case "sendInvoice"
            $sJsonFields = "|prices|suggested_tip_amounts|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "sendLivePhoto"
            $sJsonFields = "|ephemeral_message_parameters|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|live_photo|photo|"
        Case "sendLocation"
            $sJsonFields = "|ephemeral_message_parameters|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "sendMediaGroup"
            $sJsonFields = "|media|reply_parameters|"
        Case "sendMessage"
            $sJsonFields = "|ephemeral_message_parameters|entities|link_preview_options|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "sendMessageDraft"
            $sJsonFields = "|entities|"
        Case "sendPaidMedia"
            $sJsonFields = "|media|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "sendPhoto"
            $sJsonFields = "|ephemeral_message_parameters|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|photo|"
        Case "sendPoll"
            $sJsonFields = "|question_entities|options|country_codes|correct_option_ids|explanation_entities|explanation_media|description_entities|media|reply_parameters|reply_markup|"
        Case "sendRichMessage"
            $sJsonFields = "|ephemeral_message_parameters|rich_message|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "sendRichMessageDraft"
            $sJsonFields = "|rich_message|"
        Case "sendSharedWidget"
            $sJsonFields = "|caption_entities|reply_parameters|reply_markup|"
        Case "sendSticker"
            $sJsonFields = "|ephemeral_message_parameters|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|sticker|"
        Case "sendVenue"
            $sJsonFields = "|ephemeral_message_parameters|suggested_post_parameters|reply_parameters|reply_markup|"
        Case "sendVideo"
            $sJsonFields = "|ephemeral_message_parameters|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|video|thumbnail|cover|"
        Case "sendVideoNote"
            $sJsonFields = "|ephemeral_message_parameters|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|video_note|thumbnail|"
        Case "sendVoice"
            $sJsonFields = "|ephemeral_message_parameters|caption_entities|suggested_post_parameters|reply_parameters|reply_markup|"
            $sFileFields = "|voice|"
        Case "sendWidget"
            $sJsonFields = "|caption_entities|reply_parameters|reply_markup|"
        Case "setBusinessAccountGiftSettings"
            $sJsonFields = "|accepted_gift_types|"
        Case "setBusinessAccountProfilePhoto"
            $sJsonFields = "|photo|"
        Case "setChatMenuButton"
            $sJsonFields = "|menu_button|"
        Case "setChatPermissions"
            $sJsonFields = "|permissions|"
        Case "setChatPhoto"
            $sFileFields = "|photo|"
        Case "setManagedBotAccessSettings"
            $sJsonFields = "|added_user_ids|"
        Case "setMessageReaction"
            $sJsonFields = "|reaction|"
        Case "setMyCommands"
            $sJsonFields = "|commands|scope|"
        Case "setMyDefaultAdministratorRights"
            $sJsonFields = "|rights|"
        Case "setMyProfilePhoto"
            $sJsonFields = "|photo|"
        Case "setPassportDataErrors"
            $sJsonFields = "|errors|"
        Case "setStickerEmojiList"
            $sJsonFields = "|emoji_list|"
        Case "setStickerKeywords"
            $sJsonFields = "|keywords|"
        Case "setStickerMaskPosition"
            $sJsonFields = "|mask_position|"
        Case "setStickerSetThumbnail"
            $sFileFields = "|thumbnail|"
        Case "setWebhook"
            $sJsonFields = "|allowed_updates|"
            $sFileFields = "|certificate|"
        Case "stopMessageLiveLocation"
            $sJsonFields = "|reply_markup|"
        Case "stopPoll"
            $sJsonFields = "|reply_markup|"
        Case "uploadStickerFile"
            $sFileFields = "|sticker|"
        Case "verifyChat"
            $sJsonFields = "|custom_description_entities|"
        Case "verifyUser"
            $sJsonFields = "|custom_description_entities|"
        Case Else
            Return False
    EndSwitch
    Return True
EndFunc   ;==>__CCTelegram_Meta
